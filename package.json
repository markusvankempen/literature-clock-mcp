{
  "name": "literature-clock-mcp",
  "version": "1.6.4",
  "mcpName": "io.github.markusvankempen/literature-clock-mcp",
  "description": "A line for the current minute, from literature, copyright-free books, or an original voice.",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "literature-clock-mcp": "src/index.js"
  },
  "files": [
    "src",
    "data",
    "README.md",
    "docs/screenshots",
    "docs/icon.png",
    "docs/icon.svg",
    "server.json",
    "clients",
    "LICENSE",
    "NOTICE"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "ink-clock",
    "literature-clock",
    "quotes",
    "books",
    "voices",
    "stdio",
    "streamable-http",
    "cursor",
    "vscode",
    "claude",
    "clock"
  ],
  "author": {
    "name": "Markus van Kempen",
    "url": "https://markusvankempen.github.io/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markusvankempen/literature-clock-mcp.git"
  },
  "homepage": "https://github.com/markusvankempen/literature-clock-mcp",
  "bugs": {
    "url": "https://github.com/markusvankempen/literature-clock-mcp/issues"
  },
  "license": "Apache-2.0",
  "scripts": {
    "start": "MCP_MODE=http HOST=0.0.0.0 node src/index.js",
    "stdio": "MCP_MODE=stdio node src/index.js",
    "http": "MCP_MODE=http PORT=8788 node src/index.js",
    "sync": "node scripts/sync-corpus.js",
    "prepack": "node scripts/sync-corpus.js",
    "test": "node src/smoke.js",
    "test:tools": "node src/test-tools.js",
    "test:all": "node src/smoke.js && node src/test-tools.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.2",
    "express": "^5.2.1",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  }
}
